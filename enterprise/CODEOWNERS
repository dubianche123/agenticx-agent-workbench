# AgenticX Enterprise · Code Owners
#
# 规则：
# - 每条修改必须至少 1 位 owner approve
# - 安全敏感路径必须有「安全审查标识」
#
# 语法：https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# 默认：整个仓库
*                               @dubianche123

# ============ 安全敏感区（必须加强审查） ============

# 认证模块
/packages/auth/                 @dubianche123
/apps/*/cmd/                    @dubianche123

# 安全文档 + ADR
/SECURITY.md                    @dubianche123
/docs/adr/                      @dubianche123

# 端侧 Edge Agent（数据不出端的生命线）
/apps/edge-agent/               @dubianche123

# 网关策略引擎
/apps/gateway/internal/policy/  @dubianche123
/packages/policy-engine/        @dubianche123

# 审计模块
/features/audit/                @dubianche123

# 多租户 DB schema（改动影响全局）
/packages/db-schema/            @dubianche123

# CI 工作流
/.github/workflows/             @dubianche123

# ============ 业务功能区 ============

/features/chat/                 @dubianche123
/features/iam/                  @dubianche123
/features/metering/             @dubianche123

# ============ 插件区 ============

/plugins/moderation-*           @dubianche123
